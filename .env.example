# Copy to `.env` and fill in. `.env` is gitignored.
#
# OAuth 2.0 client id for "Sign in with X" (a public client, so there is no
# secret to keep). Required.
#
# Non-secret, so this may live in config.toml as `oauth_client_id` instead —
# which is the better place for a `.app` launched from Finder, since that
# sees no environment variable set in a shell.
#
# The app-only bearer token (`X_BEARER_TOKEN`) was removed in #33: it could
# not read the home timeline, post, repost, quote, like or delete, which is
# most of what this app does.
#
# NOTE (#169): this file is read from the current working directory, so it
# applies to whichever profile runs from this checkout — including a
# `cargo run --release`, which uses the *release* profile and the installed
# app's state. Put the development app's client id in
# `~/.config/twigpui-dev/config.toml` instead, so it can only ever reach the
# development build.
X_OAUTH_CLIENT_ID=

# Screen name used by `--fetch-only` (no leading @). The window itself shows
# your own home timeline.
X_TARGET_USERNAME=XDevelopers

# Number of posts to request per fetch. X API allows 5..=100.
X_MAX_RESULTS=20
