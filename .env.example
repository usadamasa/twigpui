# Copy to `.env` and fill in. `.env` is gitignored.
#
# App-only Bearer token from the X Developer Portal.
# Use the value verbatim, including any percent-encoded characters (%2F, %3D).
X_BEARER_TOKEN=

# OAuth 2.0 client id for "Sign in with X" (a public client, no secret).
# Non-secret, so this may also live in config.toml as oauth_client_id instead.
# Either this or X_BEARER_TOKEN (or both) must be set.
X_OAUTH_CLIENT_ID=

# Screen name whose posts are shown in the timeline (no leading @).
X_TARGET_USERNAME=XDevelopers

# Number of posts to request per fetch. X API allows 5..=100.
X_MAX_RESULTS=20
