{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_ALLOW_GH_PR_WRITES": "1"
  },
  "permissions": {
    "allow": [
      "Bash(cargo:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "rust-skills": {
      "source": {
        "source": "github",
        "repo": "actionbook/rust-skills"
      }
    }
  },
  "sandbox": {
    "excludedCommands": [
      "cargo *"
    ]
  },
  "enabledPlugins": {
    "rust-skills@rust-skills": true
  }
}
